# Copie para .env.local e preencha com os dados do seu projeto Supabase.
# Enquanto estiverem vazias, o site roda em "modo demonstração" com dados de exemplo.
NEXT_PUBLIC_SUPABASE_URL=
# Chave pública do projeto (Dashboard > Settings > API > "Publishable key",
# formato sb_publishable_... — é a substituta moderna da antiga "anon key").
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NUNCA expor no client. Usada apenas em rotas de servidor/API para gravações.
# Sem ela, eventos/cliques/denúncias/votos ficam em modo demo (não gravam).
SUPABASE_SERVICE_ROLE_KEY=
